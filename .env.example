# Flask Secret Key (generate with: python3 -c "import os; print(os.urandom(32).hex())")
SECRET_KEY=your-secret-key-here

# Session cookie secure flag (set to 'true' for HTTPS deployments)
SESSION_COOKIE_SECURE=false

# Redis Configuration (optional - for rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Database (SQLite by default)
# SQLALCHEMY_DATABASE_URI=sqlite:///factory_stock.db